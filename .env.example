# ---- API ----
NODE_ENV=development
API_PORT=4000
WEB_ORIGIN=http://localhost:5173

# Persistence.
# sqlite  -> zero-install local development, similarity runs in process
# postgres -> production, similarity runs in pgvector
DB_DIALECT=sqlite
DB_STORAGE=./data/itemforge.sqlite
DATABASE_URL=postgres://itemforge:itemforge@localhost:5432/itemforge

# ---- AI engine ----
AI_ENGINE_URL=http://localhost:8000
AI_ENGINE_TIMEOUT_MS=60000

# ---- AI provider ----
# fixture -> replays recorded responses, no network, deterministic
# openai  -> requires OPENAI_API_KEY
# ollama  -> requires a local Ollama daemon
AI_PROVIDER=fixture
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# ---- Review policy ----
DUPLICATE_SIMILARITY_THRESHOLD=0.88
